# Copiar a .env (ignorado por git) y rellenar. Nunca subir el .env al repositorio.

# Clave de Gemini para la consulta documental (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.1-flash-lite)
GEMINI_MODEL=

# ID del proyecto de Google Cloud del agente (cliente de voz, Sesión 5)
DIALOGFLOW_PROJECT_ID=
